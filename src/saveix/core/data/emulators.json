    {"name": "RUNE", "remote": "<public>/Documents/Steam/RUNE/{appid}/remote", "verified": false},
    {"name": "EMPRESS", "remote": "<appdata>/EMPRESS/{appid}/remote", "verified": false},
    {"name": "OnlineFix", "remote": "<public>/Documents/OnlineFix/{appid}/Saves", "verified": false},
